{
    "name": "webetdesign/wd-sortable-bundle",
    "type": "symfony-bundle",
    "description": "Provides a way to sort your admin listing",
    "keywords": [
        "sortable",
        "admin",
        "sonata"
    ],
    "homepage": "https://github.com/pix-digital/pixSortableBehaviorBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas Ricci",
            "email": "nr@pix-digital.com"
        }
    ],
    "require": {
        "php": ">=7.2.5",
        "symfony/framework-bundle": "^5.4",
        "symfony/form": "^5.4"
    },
    "require-dev": {
        "gedmo/doctrine-extensions": "^3.12"
    },
    "autoload": {
        "psr-0": {
            "Pix\\SortableBehaviorBundle": ""
        }
    },
    "target-dir": "Pix/SortableBehaviorBundle",
    "extra": {
        "branch-alias": {
            "dev-master": "0.3-dev"
        }
    }
}
